# Arquivo de exemplo. Copie para .env e preencha os valores reais.
# .env esta no .gitignore e nunca deve ser versionado.

# Vazio = cai no extrator heuristico (SPEC S13). Coloque a chave real so no .env.
LLM_API_KEY=
# Provedor em uso: Groq, compativel com a API da OpenAI. Trocar de provedor e
# trocar estas duas linhas juntas (LLM_BASE_URL e LLM_MODELO).
LLM_BASE_URL=https://api.groq.com/openai/v1
# Unico modelo grande da conta em uso com suporte a saida estruturada nativa
# (D-14); os demais so tem modo JSON, que cai no galho de degradacao de D-02.
LLM_MODELO=openai/gpt-oss-120b
LLM_MAX_CHARS=12000

# D-19: semeiam o primeiro administrador na primeira subida do processo.
# Sem as duas, nenhum administrador e criado. Nunca preencha aqui.
ADMIN_USERNAME=
ADMIN_SENHA=
